# Postgres connection string (Neon, free tier) — https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Seed script: tài khoản đăng nhập duy nhất
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me"

# Web Push (nhắc lịch liên hệ) — tạo bằng: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Bí mật để bảo vệ endpoint cron gửi thông báo hằng ngày
CRON_SECRET="generate-a-random-string"
