generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum Closeness {
  VERY_CLOSE
  CLOSE
  SOMEWHAT_CLOSE
  ACQUAINTANCE
  NEW
}

enum Priority {
  A
  B
  C
  D
  E
}

enum InteractionType {
  CALL
  MESSAGE
  EMAIL
  MEETING
  MEAL
  EVENT
  WORK
  OTHER
}

model Contact {
  id        String  @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  address   String?
  company   String?
  jobTitle  String?
  industry  String?
  birthday  DateTime?
  avatarUrl String?

  closeness Closeness @default(NEW)
  priority  Priority  @default(E)

  contactFrequencyDays Int?
  lastContactDate      DateTime?
  lastContactType      InteractionType?
  lastContactNote      String?
  nextContactDate      DateTime?

  theyCanHelpNote String?
  iCanHelpNote    String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups       ContactGroup[]
  tags         ContactTag[]
  interactions Interaction[]
  theyCanHelp  HelpTopic[]    @relation("TheyHelp")
  iCanHelp     HelpTopic[]    @relation("IHelp")

  @@index([priority, nextContactDate])
  @@index([nextContactDate])
}

model Group {
  id       String         @id @default(cuid())
  name     String         @unique
  contacts ContactGroup[]
}

model ContactGroup {
  contactId String
  groupId   String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  contacts ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model HelpTopic {
  id          String    @id @default(cuid())
  name        String    @unique
  theyHelpers Contact[] @relation("TheyHelp")
  iHelpers    Contact[] @relation("IHelp")
}

model Interaction {
  id           String           @id @default(cuid())
  contactId    String
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  date         DateTime
  type         InteractionType
  content      String?
  outcome      String?
  nextAction   String?
  followUpDate DateTime?
  followUpDone Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([contactId, date])
  @@index([followUpDate, followUpDone])
}
